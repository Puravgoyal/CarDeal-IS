{
  "name": "cardeal-is-backend",
  "version": "1.0.0",
  "description": "Backend API for Car Dealership Inventory System",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:provision": "tsx src/cli/provisionAdmin.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
